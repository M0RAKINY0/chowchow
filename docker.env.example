# Docker Desktop local-only example.
# Replace host.docker.internal with your managed service hostnames when deploying.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres:replace-me@host.docker.internal:5432/food_ordering_dev?schema=public
REDIS_URL=redis://host.docker.internal:6379/0
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SENTRY_DSN=
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
